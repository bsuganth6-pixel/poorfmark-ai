# --- Required in production -------------------------------------------------
# MongoDB Atlas connection string (use mongodb+srv://). Leave empty for DEMO MODE (in-memory data).
MONGODB_URI=
MONGODB_DB=proofmark
# 16+ random characters, e.g. `openssl rand -hex 32`. Signs session cookies.
SESSION_SECRET=

# --- Optional ----------------------------------------------------------------
# Enables Claude analysis. Without it, analysis shows as "off" and rule checks still work.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Local testing only: NEVER set these in production ----------------------
# Lets `next start` sessions work over plain http://localhost (drops Secure + __Host- cookie prefix).
# ALLOW_INSECURE_COOKIES=1
# Allows a non-TLS mongodb:// URI (e.g. a local mongod) in production mode.
# ALLOW_INSECURE_DB=1
